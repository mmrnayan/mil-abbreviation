{
  "name": "abbreviation-converter-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "Offline Abbreviation Converter for Windows",
  "author": "Abbreviation Converter",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --x64" },
  "devDependencies": { "electron": "44.7.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "bd.jssdm.abbreviationconverter",
    "productName": "Abbreviation Converter",
    "files": ["main.js", "package.json", "www/**/*"],
    "asar": true,
    "win": { "target": ["nsis", "portable"], "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
