{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "service-abbreviation-converter",
          "format": "url",
          "env": "CONVERTER_URL"
        }
      ]
    },
    "service-abbreviation-converter": {
      "root": "service-abbreviation-converter",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/converter/(.*)",
      "destination": {
        "service": "service-abbreviation-converter"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
